# Market Data System Environment Variables
# Copy this file to .env and customize for your environment

# Underlying index/symbol (NIFTY, BANKNIFTY, FINNIFTY, etc.)
UNDERLYING=NIFTY

# Market data provider: "mock" for simulated data, "replay" for deterministic
# MOCK Replay/Test Mode, "nse" for live NSE India data, "dhan" for DhanHQ.
# MARKET_DATA_PROVIDER is the preferred name and wins over DATA_SOURCE when
# both are set. It is left commented here on purpose: this template is also
# loaded as a fallback, and an uncommented value would override DATA_SOURCE
# from your own .env.
# MARKET_DATA_PROVIDER=mock
DATA_SOURCE=mock

# Poll interval in seconds (how often to fetch new prices)
POLL_INTERVAL_SECONDS=5

# Price calculator method: "mock" (default), "black_scholes", "delta_neutral"
# Note: Only "mock" is currently implemented
PRICE_CALCULATOR=mock

# Candle intervals in minutes (comma-separated)
CANDLE_INTERVALS=1,5,15

# ATM selection: "delta" (default) or "price". Delta tolerance (target |delta|).
ATM_METHOD=delta
DELTA_THRESHOLD=0.5

# Which price series feeds the candle chart: "underlying" (spot, default) or
# "combined_value" (ATM CE+PE). Also changeable live from the Settings tab.
CANDLE_PRICE_BASIS=underlying

# Deterministic MOCK Replay/Test Mode (used when DATA_SOURCE=replay).
# Sequence options: trend_up, trend_down, choppy_range, gap_and_reversal.
# Speed is a playback multiplier (2.0 = twice as fast).
REPLAY_SEQUENCE=trend_up
REPLAY_SPEED=1.0

# Paper trading (simulation only) risk thresholds — also editable live from
# the Paper Trading panel / Settings tab.
PAPER_TAKE_PROFIT_PERCENT=10.0
PAPER_STOP_LOSS_PERCENT=5.0
PAPER_DEFAULT_QUANTITY=50

# Optional: NSE API session cookie (if using NSE data source)
# NSE_SESSION_COOKIE=

# DhanHQ credentials (required if using "dhan" data source).
# Get these from https://dhan.co after creating an account.
# NEVER commit real values here — this file is a template, not a secrets store.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional: Custom API keys for future data provider integrations
# API_KEY=
# API_SECRET=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Multi-user / production settings -------------------------------------------
# NOTE: every line here is commented out ON PURPOSE. This template is also loaded as a
# fallback (see src/config.py), so an active value would silently override defaults - e.g.
# AUTH_MODE=disabled would defeat production's secure default. Set these in your real .env
# or the host's environment.
# development (default) or production. Production forces AUTH_MODE=required and
# secure cookies, and the app refuses to start otherwise.
# APP_ENV=development
# "disabled": single implicit local user + original global behaviour (local dev and
# the legacy UI only). "required": real accounts, per-user paper trading.
# AUTH_MODE=disabled
# Required when AUTH_MODE=required: >= 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# SQLAlchemy URL. Default is a local SQLite file. Production: managed PostgreSQL,
# e.g. postgresql://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=
# Pool sizing / timeouts (PostgreSQL only)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=10000
# Comma-separated browser origins allowed to call the API (empty = same-origin only)
# CORS_ORIGINS=https://app.example.com
# Number of reverse proxies in front of the app (0 = ignore X-Forwarded-For)
# TRUSTED_PROXY_HOPS=0
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14
# REGISTRATION_OPEN=true
