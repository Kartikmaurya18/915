__pycache__/
*.pyc
.venv/
.env
data/*
*.db
.pytest_cache/

# Exception: a committed seed copy of historical MOCK data ships with the
# deploy so Railway's ephemeral filesystem (no volume mounted) has previous
# trading sessions available immediately after every deploy/restart, not
# just live data generated after boot. See src/persistence.py::ensure_seeded()
# and MarketEngine's persistence setup in src/engine.py. Never the live/local
# runtime DB (data/market_data.db itself stays ignored via the "data/*" rule
# above — this only re-includes the one seed file below it).
!data/seed/
data/seed/*
!data/seed/market_data.seed.db

# Exception: the committed NSE trading-holiday table (plain JSON, not a
# database) used by src/market_calendar.py — see that module's docstring.
!data/nse_holidays.json

# Local run output
*.log
