# Production environment template.
#
# Copy to your secret manager / platform settings and fill in the <placeholders>. The app does NOT read this
# file (never commit real values, and never copy these lines into .env.example, which ships in the image and is
# guarded by a test against active security settings). One set for gateways, one for ingestors; the shared
# values are the same. See docs/DEPLOYMENT.md for the meaning of each.

# -- every process ---------------------------------------------------------------------------
APP_ENV=production                      # forces AUTH_MODE=required and secure cookies; refuses unsafe start-up
AUTH_MODE=required
JWT_SECRET=<48+ random characters>      # python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
REDIS_URL=rediss://:<password>@<host>:6379/0      # rediss:// for TLS. Private network only.
RT_PREFIX=rt:                           # change if several environments share one Redis
MARKET_DATA_PROVIDER=mock               # keep "mock" until data-licensing is settled (docs/DEPLOYMENT.md)
POLL_INTERVAL_SECONDS=1

# -- gateways (python -m uvicorn src.api.server:app --host 0.0.0.0 --port 8000 --ws-max-size 65536) --------
REALTIME_MODE=gateway
CORS_ORIGINS=                           # empty = same-origin only, which is what the bundled web app needs
TRUSTED_PROXY_HOPS=1                    # number of proxies you control in front (load balancer = 1)
METRICS_TOKEN=<random token>            # required to scrape /metrics
REGISTRATION_OPEN=true
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_TOTAL=800            # per gateway process; see docs/CAPACITY.md
RATE_LIMIT_BACKEND=redis                # shared login/registration limits across gateways
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -- ingestors (python -m src.ingestor), run two ----------------------------------------------------------
# REALTIME_MODE is unset for ingestors.
INGESTOR_ID=<unique per instance>       # e.g. the hostname
INGESTOR_LEASE_TTL_MS=6000
INGESTOR_METRICS_PORT=9100
MARKET_HISTORY_BACKEND=sql              # history in the shared database (the default when DATABASE_URL is set)

# -- one-off release step ---------------------------------------------------------------------------------
# alembic upgrade head                  # once per release, before starting new instances
